DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# куда compose пробрасывает postgres на хосте
DB_HOST_PORT=5444

# подключение Django при локальном запуске (база из compose)
POSTGRES_DB=ugc
POSTGRES_USER=ugc
POSTGRES_PASSWORD=ugc
POSTGRES_HOST=localhost
POSTGRES_PORT=5444

# временная идентификация по X-User-Id, в проде выключить
HEADER_AUTH_ENABLED=1
